{
  "name": "insulincalc",
  "private": true,
  "version": "7.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "ci": "npm run lint && npm run typecheck && npm run test:regression && npm run test:coverage && npm run build && npm run test:e2e",
    "test": "vitest run",
    "test:regression": "vitest run src/__tests__/spec-compliance.test.js src/__tests__/v57-enhancements.test.js src/utils/__tests__/clinicalEngine.test.js src/domain/engine/__tests__ src/data/__tests__ src/utils/__tests__/dosePlan.test.js src/utils/__tests__/updateManager.test.js src/components/__tests__/VersionPanel.test.jsx src/components/__tests__/DayTimeline.test.jsx",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.1",
    "vitest": "^4.1.1"
  }
}
