# Variables d'environnement de build (Vite). Copier en .env.local (ignoré par git) pour le développement.
# ATTENTION : toute variable VITE_* est incluse dans le bundle publié. Ne mettez ici que des clés
# dont vous acceptez l'exposition (usage personnel, plafond de dépense fixé chez le fournisseur).
# En production, ces valeurs viennent des secrets GitHub Actions (Settings → Secrets and variables → Actions) :
#   OPENROUTER_API_KEY (secret), OPENROUTER_MODEL (variable, optionnel), GROQ_API_KEY (secret, optionnel), AI_PROVIDER (variable, optionnel)

# Fournisseur par défaut : openrouter | groq (déduit des clés présentes si vide)
VITE_AI_PROVIDER=
# Clé OpenRouter (préfixe sk-or-) et modèle vision OpenAI-compatible
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=meta-llama/llama-4-scout
# Clé Groq (préfixe gsk_), alternative gratuite
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
